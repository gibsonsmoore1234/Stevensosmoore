# Copy to .env.local for local preview (npm run dev). On Vercel these come from
# the Supabase integration or Project → Settings → Environment Variables.
# Only the PUBLIC anon/publishable key belongs here — never the service_role/secret key.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
